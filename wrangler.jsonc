{
  "name": "dashboard-almoxarifados",
  "compatibility_date": "2026-09-08",
  "main": "src/fast-worker.js",
  "build": {
    "command": "node scripts/build-fast.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DASHBOARD_USER": "gestao"
  }
}
